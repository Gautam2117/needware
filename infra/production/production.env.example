# Install as /etc/needware/production.env, root-owned, mode 600.
# Do not reuse development credentials. Populate secrets through the host store.
NODE_ENV=production
NEEDWARE_RELEASE_SHA=
BETTER_AUTH_URL=
DATABASE_URL=
NEEDWARE_DATABASE_CA_PEM=
BETTER_AUTH_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NEEDWARE_MAIL_FROM=
NEEDWARE_TRUST_PROXY=caddy-loopback
NEEDWARE_HOSTED_GENERATION=1
NEEDWARE_CONTROL_URL=http://127.0.0.1:3001
NEEDWARE_CONTROL_PORT=3001
NEEDWARE_CONTROL_TOKEN=
NEEDWARE_SIGNING_SEED_HEX=
NEEDWARE_BACKUP_KEY=
NEEDWARE_OPERATOR_ACCOUNTS=
NEEDWARE_PROVIDER=open_ai
NEEDWARE_MODEL=
OPENAI_API_KEY=
NEEDWARE_INPUT_MICROUSD_PER_MILLION=
NEEDWARE_OUTPUT_MICROUSD_PER_MILLION=
NEEDWARE_COST_CEILING_MICROUSD=500000
NEEDWARE_FIXTURE_MODE=0
NEEDWARE_ALLOW_LOOPBACK=0
NEEDWARE_BILLING_FIXTURE=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ACCOUNT_ID=
