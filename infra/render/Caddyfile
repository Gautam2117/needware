{
    admin off
    auto_https off
}
:{$PORT:10000} {
    encode gzip
    @unknown not host {$NEEDWARE_PUBLIC_HOST} {$RENDER_EXTERNAL_HOSTNAME}
    respond @unknown "Unknown host" 421
    @alias {
        host {$NEEDWARE_ALIAS_REDIRECT_HOST}
        not path /api/health
    }
    redir @alias https://{$NEEDWARE_PUBLIC_HOST}{uri} 308
    header Strict-Transport-Security "max-age=31536000"
    reverse_proxy 127.0.0.1:3000 {
        header_up -X-Needware-Auth-IP
        # Conservative peer address; never trust a caller-supplied forwarding chain.
        header_up X-Needware-Client-IP {remote_host}
        header_up -X-Forwarded-For
        header_up -X-Vercel-Forwarded-For
        header_up -X-Real-IP
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
