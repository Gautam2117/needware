# No real keys belong here. Local execution and domain tests need no credentials.
# Bootstrap provides a random-password local URL in ignored .local/dev.env.
# Set this only to use a different database.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
SMTP_HOST=
# Bootstrap supplies Mailpit's port. Set this for a configured external SMTP service.
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NEEDWARE_MAIL_FROM=
# Supported ingress: vercel on Vercel, or caddy-loopback with the managed loopback web service.
NEEDWARE_TRUST_PROXY=
NEEDWARE_DATABASE_CA_PEM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Set an explicit provider, model and credentials only to enable real generation.
NEEDWARE_PROVIDER=
NEEDWARE_MODEL=
NEEDWARE_LOCAL_ENDPOINT=http://127.0.0.1:11434/v1/chat/completions
NEEDWARE_ALLOW_LOOPBACK=0
NEEDWARE_FIXTURE_MODE=0
# Rates and ceiling are integer micro-US dollars. Set rates explicitly, including zero for local inference.
NEEDWARE_INPUT_MICROUSD_PER_MILLION=
NEEDWARE_OUTPUT_MICROUSD_PER_MILLION=
NEEDWARE_COST_CEILING_MICROUSD=500000
# Stable private installation package signer; generate 32 random bytes and keep this in the deployment secret store.
NEEDWARE_SIGNING_SEED_HEX=
# Enable only with configured accounts, a generation worker and the private Rust gateway.
NEEDWARE_HOSTED_GENERATION=0
# wire is the default; canonical uses bounded JSON mode with an OpenAI-compatible HTTP adapter.
NEEDWARE_APPLICATION_FORMAT=wire
# Scheduled mode requires bounded invocations at this interval; Cashfree supports bounded billing ticks.
NEEDWARE_WORKER_MODE=continuous
NEEDWARE_WORKER_INTERVAL_SECONDS=300
# Optional Stripe billing: configured approved monthly recurring price (USD/INR/EUR/GBP).
# Set disabled for a free beta, with all four Stripe settings empty. Unknown modes block billing.
NEEDWARE_BILLING_MODE=stripe
# Configure its signed webhook at /api/billing/webhook and run pnpm billing:worker.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ACCOUNT_ID=
# Cashfree primary billing: set NEEDWARE_BILLING_MODE=cashfree explicitly.
# Credentials remain server-side. Sandbox cannot grant Pro on a public HTTPS installation.
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Credential namespace: cf_ plus the first 32 lowercase hex characters of SHA256(client ID).
CASHFREE_MERCHANT_ID=
CASHFREE_PRO_PLAN_ID=needware_pro_monthly_499
CASHFREE_PRO_MONTHLY_PAISE=49900
# Operator approval only after merchant/Subscriptions approval and real acceptance.
CASHFREE_LIVE_APPROVED=0
CASHFREE_LIVE_ACCEPTANCE_APPROVED=0
NEEDWARE_OPERATOR_ACCOUNTS=
NEEDWARE_BACKUP_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
